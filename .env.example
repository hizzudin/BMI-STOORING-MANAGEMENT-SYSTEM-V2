# Copy to .env for local development. Local-only values: see docs/dev-setup.md.
DATABASE_URL=postgres://bmi:bmi_local_dev@localhost:5432/bmi_dev
REDIS_URL=redis://localhost:6379
PORT=3001
# Integration tests: an account allowed to create databases (design.md D-02).
TEST_DATABASE_URL=postgres://bmi:bmi_local_dev@localhost:5432/bmi_dev
# Storage (NFR-13, DEC-135): fs locally and in tests, s3 (Cloudflare R2) in staging and production.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/storage
STORAGE_PUBLIC_URL=http://localhost:3001
# Required in production; set your own value, never commit it.
STORAGE_SIGNING_SECRET=
# Only with STORAGE_DRIVER=s3; leave empty locally (the S3 contract run is then skipped).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
