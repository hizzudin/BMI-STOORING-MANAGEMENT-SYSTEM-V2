# Line endings: LF everywhere, as .editorconfig says; git detects binary files itself.
* text=auto eol=lf

# Windows scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.heic binary
*.pdf binary
*.exe binary
*.apk binary
*.aab binary
