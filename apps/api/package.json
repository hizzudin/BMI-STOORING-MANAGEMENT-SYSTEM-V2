{
  "name": "@bmi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --project unit --passWithNoTests",
    "test:int": "vitest run --project int",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node dist/infra/db/migrate-cli.js",
    "openapi:emit": "node dist/http/openapi/emit.js",
    "e2e:db": "node dist/infra/db/e2e-database-cli.js"
  },
  "dependencies": {
    "@bmi/shared": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "bullmq": "^6.5.4",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bmi/config": "workspace:*",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "vitest": "^5.1.0"
  }
}
