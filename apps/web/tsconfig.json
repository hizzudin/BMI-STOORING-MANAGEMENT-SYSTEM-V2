{
  "extends": "@bmi/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": false,
    "incremental": true,
    "exactOptionalPropertyTypes": false,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "app", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
