{
  "openapi": "3.1.0",
  "info": {
    "title": "BMI Stooring System API",
    "version": "0.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Tells whether the API is running",
        "responses": {
          "200": {
            "description": "Tells whether the API is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/sign-in": {
      "post": {
        "operationId": "signIn",
        "summary": "Signs in with email and password (web: cookies, phone: tokens in the body)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signs in with email and password (web: cookies, phone: tokens in the body)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "summary": "Renews the access token and rotates the refresh token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Renews the access token and rotates the refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/sign-out": {
      "post": {
        "operationId": "signOut",
        "summary": "Ends this session (C-04)",
        "responses": {
          "200": {
            "description": "Ends this session (C-04)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "operationId": "changePassword",
        "summary": "Changes the password; the current one is asked except at the first sign-in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Changes the password; the current one is asked except at the first sign-in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "operationId": "forgotPassword",
        "summary": "Emails one reset link when the address belongs to an active account (DEC-102)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Emails one reset link when the address belongs to an active account (DEC-102)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "operationId": "resetPassword",
        "summary": "Sets a new password from a reset link (once, within 60 minutes)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sets a new password from a reset link (once, within 60 minutes)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "The signed-in account, its effective capability set and the system mode (REQ-IAM-013)",
        "responses": {
          "200": {
            "description": "The signed-in account, its effective capability set and the system mode (REQ-IAM-013)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts": {
      "get": {
        "operationId": "listAccounts",
        "summary": "Users and roles: Accounts",
        "responses": {
          "200": {
            "description": "Users and roles: Accounts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAccount",
        "summary": "New account with one role and a one-time temporary password (FLW-AM-01)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New account with one role and a one-time temporary password (FLW-AM-01)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountWithPassword"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{id}": {
      "patch": {
        "operationId": "updateAccount",
        "summary": "Edit the name, email and the one role of an account",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Edit the name, email and the one role of an account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{id}/unlock": {
      "post": {
        "operationId": "unlockAccount",
        "summary": "Unlock after 5 failed sign-ins",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unlock after 5 failed sign-ins",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{id}/deactivate": {
      "post": {
        "operationId": "deactivateAccount",
        "summary": "Deactivate an account and end its sessions (FLW-AM-04)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deactivate an account and end its sessions (FLW-AM-04)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{id}/activate": {
      "post": {
        "operationId": "activateAccount",
        "summary": "Activate a deactivated account",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Activate a deactivated account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{id}/reset-password": {
      "post": {
        "operationId": "resetAccountPassword",
        "summary": "A new one-time temporary password, changed at the next sign-in (REQ-IAM-009)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A new one-time temporary password, changed at the next sign-in (REQ-IAM-009)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountWithPassword"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/move-system-admin": {
      "post": {
        "operationId": "moveSystemAdmin",
        "summary": "Move the System Admin role to another active account, with a reason (FLW-AM-03)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveSystemAdminRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Move the System Admin role to another active account, with a reason (FLW-AM-03)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "SignInResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "Planner",
                      "Mechanic",
                      "Warehouse_Manager",
                      "Supervisor",
                      "GM",
                      "System_Admin",
                      "Access_Manager",
                      "Driver",
                      "Field_Coordinator",
                      "Accounting"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mustChangePassword": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "role",
              "mustChangePassword"
            ],
            "additionalProperties": false
          },
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "SignInRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "client": {
            "type": "string",
            "enum": [
              "web",
              "mobile"
            ]
          }
        },
        "required": [
          "email",
          "password",
          "client"
        ],
        "additionalProperties": false
      },
      "RefreshRequest": {
        "default": {},
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "OkResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "Planner",
                      "Mechanic",
                      "Warehouse_Manager",
                      "Supervisor",
                      "GM",
                      "System_Admin",
                      "Access_Manager",
                      "Driver",
                      "Field_Coordinator",
                      "Accounting"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mustChangePassword": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "role",
              "mustChangePassword"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "allOf": [
              {
                "pattern": "[A-Za-z]"
              },
              {
                "pattern": "\\d"
              }
            ]
          },
          "repeatPassword": {
            "type": "string"
          }
        },
        "required": [
          "newPassword",
          "repeatPassword"
        ],
        "additionalProperties": false
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "allOf": [
              {
                "pattern": "[A-Za-z]"
              },
              {
                "pattern": "\\d"
              }
            ]
          },
          "repeatPassword": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "newPassword",
          "repeatPassword"
        ],
        "additionalProperties": false
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "Planner",
                      "Mechanic",
                      "Warehouse_Manager",
                      "Supervisor",
                      "GM",
                      "System_Admin",
                      "Access_Manager",
                      "Driver",
                      "Field_Coordinator",
                      "Accounting"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mustChangePassword": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "role",
              "mustChangePassword"
            ],
            "additionalProperties": false
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "dashboard.view",
                "spk.view",
                "spk.create",
                "breakdown.view",
                "breakdown.review",
                "breakdown.send",
                "breakdown.urgent_alert",
                "spk.approve",
                "spk.cancel",
                "stock.issue",
                "purchase.line",
                "mechanic.execute",
                "mobilisasi.execute",
                "docstep.execute",
                "step.verify",
                "step.request_completion",
                "step.assign",
                "changerequest.raise",
                "registry.manage",
                "parttype.manage",
                "masterdata.manage",
                "settings.manage",
                "vehicle.view",
                "vehicle.manage",
                "vehicle.driver_set",
                "odometer.manual",
                "inspection.proxy",
                "inspection.perform",
                "driver.menu",
                "inventory.manage",
                "tyre.manage",
                "count.approve",
                "schedule.view",
                "schedule.manage",
                "partage.view",
                "invoice.view",
                "invoice.manage",
                "report.view",
                "audit.view",
                "accounts.manage",
                "iam.planner_approval_switch",
                "ai.settings",
                "setup.golive",
                "files.upload"
              ]
            }
          },
          "systemMode": {
            "type": "string",
            "enum": [
              "Setup",
              "Live"
            ]
          }
        },
        "required": [
          "user",
          "capabilities",
          "systemMode"
        ],
        "additionalProperties": false
      },
      "AccountListResponse": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "role": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "Planner",
                        "Mechanic",
                        "Warehouse_Manager",
                        "Supervisor",
                        "GM",
                        "System_Admin",
                        "Access_Manager",
                        "Driver",
                        "Field_Coordinator",
                        "Accounting"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "Active",
                    "Locked",
                    "Inactive"
                  ]
                },
                "lastSignInAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "allowedActions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "edit",
                      "unlock",
                      "reset_password",
                      "deactivate",
                      "activate"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "name",
                "email",
                "role",
                "status",
                "lastSignInAt",
                "allowedActions"
              ],
              "additionalProperties": false
            }
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "create",
                "move_system_admin"
              ]
            }
          }
        },
        "required": [
          "accounts",
          "allowedActions"
        ],
        "additionalProperties": false
      },
      "AccountWithPassword": {
        "type": "object",
        "properties": {
          "account": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "Planner",
                      "Mechanic",
                      "Warehouse_Manager",
                      "Supervisor",
                      "GM",
                      "System_Admin",
                      "Access_Manager",
                      "Driver",
                      "Field_Coordinator",
                      "Accounting"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "Active",
                  "Locked",
                  "Inactive"
                ]
              },
              "lastSignInAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "allowedActions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "edit",
                    "unlock",
                    "reset_password",
                    "deactivate",
                    "activate"
                  ]
                }
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "role",
              "status",
              "lastSignInAt",
              "allowedActions"
            ],
            "additionalProperties": false
          },
          "temporaryPassword": {
            "type": "string"
          }
        },
        "required": [
          "account",
          "temporaryPassword"
        ],
        "additionalProperties": false
      },
      "AccountRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "maxLength": 150,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "Planner",
              "Mechanic",
              "Warehouse_Manager",
              "Supervisor",
              "GM",
              "Access_Manager",
              "Driver",
              "Field_Coordinator",
              "Accounting"
            ]
          }
        },
        "required": [
          "name",
          "email",
          "role"
        ],
        "additionalProperties": false
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "account": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "Planner",
                      "Mechanic",
                      "Warehouse_Manager",
                      "Supervisor",
                      "GM",
                      "System_Admin",
                      "Access_Manager",
                      "Driver",
                      "Field_Coordinator",
                      "Accounting"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "Active",
                  "Locked",
                  "Inactive"
                ]
