{
  "name": "@bmi/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate": "openapi-typescript openapi.json -o src/schema.gen.ts"
  },
  "devDependencies": {
    "@bmi/config": "workspace:*",
    "@vitest/coverage-v8": "^5.1.0",
    "openapi-typescript": "^7.13.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
